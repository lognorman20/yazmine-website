# Copy to .env.local (gitignored) and fill in.
# Google OAuth client (Web application) from Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# From: node --env-file=.env.local scripts/get-google-refresh-token.mjs (writes it here)
GOOGLE_REFRESH_TOKEN=
# "primary" or the calendar's ID from Google Calendar settings.
GOOGLE_CALENDAR_ID=primary
# Optional. Invited to every booking alongside the client, for when the calendar owner is not the stylist.
STYLIST_EMAIL=
# Shopify Storefront API. Both ship to the browser; use the public Storefront token, never an Admin token.
# Domain like your-store.myshopify.com.
VITE_SHOPIFY_STORE_DOMAIN=
VITE_SHOPIFY_STOREFRONT_TOKEN=
