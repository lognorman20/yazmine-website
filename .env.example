# Copy to .env.local (gitignored) and fill in.
# Google OAuth client (Web application) from Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# From: node --env-file=.env.local scripts/get-google-refresh-token.mjs (writes it here)
GOOGLE_REFRESH_TOKEN=
# "primary" or the calendar's ID from Google Calendar settings.
GOOGLE_CALENDAR_ID=primary
# Invited to every booking alongside the client. Change freely; no sign-in needed.
STYLIST_EMAIL=
